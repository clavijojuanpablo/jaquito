---
/**
 * Imagen o placeholder. Con foto: <picture> AVIF/WebP responsive.
 * Sin foto: bloque de color (data-ph) con la etiqueta, igual que el diseño.
 * `mobile` / `desktop` permiten dirección de arte (dos fotos distintas).
 */
import type { ImageMetadata } from 'astro';
import { pic } from '../lib/img';

interface Props {
  img?: ImageMetadata | null;
  mobile?: ImageMetadata | null;
  desktop?: ImageMetadata | null;
  ph?: string;
  label?: string;
  alt?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
}
const { img, mobile, desktop, ph, label = '', alt = '', sizes = '100vw', widths, eager = false, class: cls = '' } = Astro.props;

const art = mobile || desktop;
const single = img ?? null;
const [p, pm, pd] = await Promise.all([
  single ? pic(single, widths) : null,
  art ? pic((mobile ?? desktop)!, widths) : null,
  art && desktop ? pic(desktop, widths) : null
]);
const has = !!(p || pm);
---
<div class:list={['slot', cls]} data-ph={ph}>
  {has ? (
    p ? (
      <picture>
        {p.sources.map((s) => <source type={s.type} srcset={s.srcset} sizes={sizes} />)}
        <img src={p.src} width={p.width} height={p.height} alt={alt} sizes={sizes}
          loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" draggable="false" />
      </picture>
    ) : (
      <picture>
        {pd && pd.sources.map((s) => <source media="(min-width:1000px)" type={s.type} srcset={s.srcset} sizes={sizes} />)}
        {pm!.sources.map((s) => <source type={s.type} srcset={s.srcset} sizes={sizes} />)}
        <img src={pm!.src} width={pm!.width} height={pm!.height} alt={alt} sizes={sizes}
          loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" draggable="false" />
      </picture>
    )
  ) : (
    label ? <span class="slot__ph">{label}</span> : null
  )}
</div>
