---
import '../styles/fonts.css';
import '../styles/design.css';
import '../styles/adapt.css';
import Nav from '../components/Nav.astro';
import Menu from '../components/Menu.astro';
import Icon from '../components/Icon.astro';
import { waLink, type Lang, type RouteKey } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  current?: RouteKey;
  path: string;              // ruta de esta página (canónica)
  altPath: string;           // ruta equivalente en el otro idioma
  overHero?: boolean;
  back?: { href: string; label: string };
  fab?: boolean;
  ogImage?: string;
}
const { lang, title, description, current, path, altPath, overHero = false, back, fab = true, ogImage } = Astro.props;
const site = Astro.site ?? new URL('https://jaquito.art');
const url = new URL(path, site).href;
const altUrl = new URL(altPath, site).href;
const es = lang === 'es';
const spec = {
  prerender: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/docs/*' } }] }, eagerness: 'moderate' }]
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#f7f6f2" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang={lang} href={url} />
    <link rel="alternate" hreflang={es ? 'en' : 'es'} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={es ? url : altUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jaquito" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={es ? 'es_CO' : 'en_US'} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, site).href} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script type="speculationrules" set:html={JSON.stringify(spec)} />
    <slot name="head" />
  </head>
  <body class="mode-mobile mode-desktop" style="--nav-h:54px">
    <a class="sr-only" href="#main">{es ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Nav lang={lang} current={current} over={overHero} back={back} altHref={altPath} />
    <Menu lang={lang} current={current} />
    <div class="screen">
      <main id="main"><slot /></main>
    </div>
    {fab && (
      <a class="wa-fab" href={waLink()} target="_blank" rel="noreferrer" aria-label="WhatsApp"><Icon name="whatsapp" size={26} /></a>
    )}
    <slot name="overlays" />
    <script>
      import '../scripts/base.ts';
    </script>
  </body>
</html>
